        <mxCell id="MKjZ7j6y8XT1brRPclkZ-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp; &amp;nbsp; Given:&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; fc-located-before: holds(&amp;lt;target_object&amp;gt; is located at &amp;lt;pick_ws&amp;gt;, before &amp;lt;evt_pick_start&amp;gt;)&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; When:&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Behaviour (ns=bdd_tmpl) pickplace {&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; duration: from &amp;lt;evt_pick_start&amp;gt; until &amp;lt;evt_place_end&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;lt;robot&amp;gt; picks &amp;lt;target_object&amp;gt; and places at &amp;lt;place_ws&amp;gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; Then:&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; fc-located-after: holds(&amp;lt;target_object&amp;gt; is located at &amp;lt;place_ws&amp;gt;, after &amp;lt;evt_pick_start&amp;gt;)&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; and&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; fc-reachable: holds(&amp;lt;robot&amp;gt; can reach &amp;lt;target_object&amp;gt;, before &amp;lt;evt_pick_start&amp;gt;)&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; )&lt;/p&gt;" vertex="1">
